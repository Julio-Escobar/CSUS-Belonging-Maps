# Copy this file to .env and fill in the real values. .env is gitignored.

# Backend base URL (P1-214). No trailing slash.
#   Android emulator -> http://10.0.2.2:5162   (10.0.2.2 is the host machine)
#   iOS simulator    -> http://localhost:5162
#   Real phone       -> http://<your computer LAN IP>:5162 (same Wi-Fi, backend must listen on 0.0.0.0)
API_BASE_URL=http://10.0.2.2:5162

# ArcGIS API Key (basemap styles only)
ARCGIS_API_KEY=

# Somos Layer URLs
SOMOS_FOOD_URL=
SOMOS_RELIGION_URL=
SOMOS_BUSINESSES_URL=
SOMOS_PUBLIC_ARTS_URL=
SOMOS_COMMUNITY_SERVICES_URL=
SOMOS_EDUCATION_URL=

# Ummah Layer URLs
UMMAH_BUSINESS_SERVICES_URL=
UMMAH_COMMUNITY_SERVICES_URL=
UMMAH_HALAL_FOODS_URL=
UMMAH_RELIGIOUS_CULTURAL_URL=
UMMAH_EDUCATION_URL=

# Ubuntu Layer URLs
UBUNTU_BUSINESSES_URL=
UBUNTU_COMMUNITY_SERVICES_URL=
UBUNTU_RELIGIOUS_URL=
UBUNTU_EDUCATION_URL=
